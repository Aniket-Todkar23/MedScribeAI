# AI Core Service — Environment Variables
# ==========================================

# Modal GPU endpoints (REQUIRED)
MODAL_MEDGEMMA_URL=https://your-modal-medgemma-endpoint.modal.run
MODAL_QWEN_VL_URL=https://your-modal-qwen-vl-endpoint.modal.run

# Whisper transcription config
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# ICD CSV paths (relative to project root for local dev)
ICD9_CSV_PATH=unique_icd9_codes.csv
ICD10_CSV_PATH=unique_icd10_codes.csv

# Server
HOST=0.0.0.0
PORT=8000
