{
    "info": {
        "name": "MedScribe AI — Backend API",
        "_postman_id": "medscribe-ai-v2-complete",
        "description": "Complete API test collection for MedScribe AI — EMR & Diagnostic Assistant.\n\nRun requests in order — tokens and IDs are auto-saved from signup/login.\n\n69 backend endpoints + 1 health check + 11 AI core endpoints.\n\nBase URL: http://localhost:3001",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        { "key": "base", "value": "http://localhost:3001/api/v1", "type": "string" },
        { "key": "host", "value": "http://localhost:3001", "type": "string" },
        { "key": "ai_core", "value": "http://localhost:8000/api/v1", "type": "string" },
        { "key": "doctor_token", "value": "", "type": "string" },
        { "key": "patient_token", "value": "", "type": "string" },
        { "key": "doctor_refresh", "value": "", "type": "string" },
        { "key": "patient_refresh", "value": "", "type": "string" },
        { "key": "doctor_id", "value": "", "type": "string" },
        { "key": "patient_id", "value": "", "type": "string" },
        { "key": "appointment_id", "value": "", "type": "string" },
        { "key": "consultation_id", "value": "", "type": "string" },
        { "key": "document_id", "value": "", "type": "string" },
        { "key": "session_id", "value": "postman-session-001", "type": "string" }
    ],
    "item": [
        {
            "name": "0. Health Check",
            "item": [
                {
                    "name": "Server Health",
                    "event": [{ "listen": "test", "script": { "exec": ["pm.test('Server healthy', () => { pm.response.to.have.status(200); const json = pm.response.json(); pm.expect(json.service).to.eql('medscribe-ai-backend'); });"], "type": "text/javascript" } }],
                    "request": { "method": "GET", "header": [], "url": { "raw": "{{host}}/health", "host": ["{{host}}"], "path": ["health"] } }
                }
            ]
        },
        {
            "name": "1. Authentication",
            "item": [
                {
                    "name": "1.1 Signup Doctor",
                    "event": [{ "listen": "test", "script": { "exec": ["pm.test('Doctor signup 201', () => { pm.response.to.have.status(201); }); const json = pm.response.json(); if (json.access_token) { pm.collectionVariables.set('doctor_token', json.access_token); pm.collectionVariables.set('doctor_refresh', json.refresh_token); pm.collectionVariables.set('doctor_id', json.user.id); }"], "type": "text/javascript" } }],
                    "request": {
                        "method": "POST",
                        "header": [{ "key": "Content-Type", "value": "application/json" }],
                        "body": { "mode": "raw", "raw": "{\n  \"full_name\": \"Dr. Postman Tester\",\n  \"email\": \"doctor@medscribe.dev\",\n  \"password\": \"test1234\",\n  \"specialization\": \"Internal Medicine\",\n  \"license_number\": \"PM-DOC-001\",\n  \"hospital_name\": \"MedScribe AI Hospital\",\n  \"phone\": \"+911234567890\"\n}" },
                        "url": { "raw": "{{base}}/auth/signup/doctor", "host": ["{{base}}"], "path": ["auth", "signup", "doctor"] }
                    }
                },
                {
                    "name": "1.2 Signup Patient",
                    "event": [{ "listen": "test", "script": { "exec": ["pm.test('Patient signup 201', () => { pm.response.to.have.status(201); }); const json = pm.response.json(); if (json.access_token) { pm.collectionVariables.set('patient_token', json.access_token); pm.collectionVariables.set('patient_refresh', json.refresh_token); pm.collectionVariables.set('patient_id', json.user.id); }"], "type": "text/javascript" } }],
                    "request": {
                        "method": "POST",
                        "header": [{ "key": "Content-Type", "value": "application/json" }],
                        "body": { "mode": "raw", "raw": "{\n  \"full_name\": \"Patient Postman Demo\",\n  \"email\": \"patient@medscribe.dev\",\n  \"password\": \"test1234\",\n  \"phone\": \"+911234567891\",\n  \"date_of_birth\": \"1995-06-15\",\n  \"gender\": \"male\",\n  \"blood_group\": \"O+\"\n}" },
                        "url": { "raw": "{{base}}/auth/signup/patient", "host": ["{{base}}"], "path": ["auth", "signup", "patient"] }
                    }
                },
                {
                    "name": "1.3 Login Doctor",
                    "event": [{ "listen": "test", "script": { "exec": ["pm.test('Login OK', () => { pm.response.to.have.status(200); }); const json = pm.response.json(); if (json.access_token) { pm.collectionVariables.set('doctor_token', json.access_token); pm.collectionVariables.set('doctor_refresh', json.refresh_token); pm.collectionVariables.set('doctor_id', json.user.id); }"], "type": "text/javascript" } }],
                    "request": {
                        "method": "POST",
                        "header": [{ "key": "Content-Type", "value": "application/json" }],
                        "body": { "mode": "raw", "raw": "{\n  \"email\": \"doctor@medscribe.dev\",\n  \"password\": \"test1234\"\n}" },
                        "url": { "raw": "{{base}}/auth/login", "host": ["{{base}}"], "path": ["auth", "login"] }
                    }
                },
                {
                    "name": "1.4 Login Patient",
                    "event": [{ "listen": "test", "script": { "exec": ["pm.test('Login OK', () => { pm.response.to.have.status(200); }); const json = pm.response.json(); if (json.access_token) { pm.collectionVariables.set('patient_token', json.access_token); pm.collectionVariables.set('patient_refresh', json.refresh_token); pm.collectionVariables.set('patient_id', json.user.id); }"], "type": "text/javascript" } }],
                    "request": {
                        "method": "POST",
                        "header": [{ "key": "Content-Type", "value": "application/json" }],
                        "body": { "mode": "raw", "raw": "{\n  \"email\": \"patient@medscribe.dev\",\n  \"password\": \"test1234\"\n}" },
                        "url": { "raw": "{{base}}/auth/login", "host": ["{{base}}"], "path": ["auth", "login"] }
                    }
                },
                {
                    "name": "1.5 Get My Profile (Doctor)",
                    "event": [{ "listen": "test", "script": { "exec": ["pm.test('Profile OK', () => { pm.response.to.have.status(200); });"], "type": "text/javascript" } }],
                    "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{doctor_token}}" }], "url": { "raw": "{{base}}/auth/me", "host": ["{{base}}"], "path": ["auth", "me"] } }
                },
                {
                    "name": "1.6 Get My Profile (Patient)",
                    "event": [{ "listen": "test", "script": { "exec": ["pm.test('Profile OK', () => { pm.response.to.have.status(200); });"], "type": "text/javascript" } }],
                    "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{patient_token}}" }], "url": { "raw": "{{base}}/auth/me", "host": ["{{base}}"], "path": ["auth", "me"] } }
                },
                {
                    "name": "1.7 Refresh Token (Doctor)",
                    "event": [{ "listen": "test", "script": { "exec": ["pm.test('Refresh OK', () => { pm.response.to.have.status(200); }); const json = pm.response.json(); if (json.access_token) { pm.collectionVariables.set('doctor_token', json.access_token); pm.collectionVariables.set('doctor_refresh', json.refresh_token); }"], "type": "text/javascript" } }],
                    "request": {
                        "method": "POST",
                        "header": [{ "key": "Content-Type", "value": "application/json" }],
                        "body": { "mode": "raw", "raw": "{\n  \"refresh_token\": \"{{doctor_refresh}}\"\n}" },
                        "url": { "raw": "{{base}}/auth/refresh", "host": ["{{base}}"], "path": ["auth", "refresh"] }
                    }
                }
            ]
        },
        {
            "name": "2. Patients",
            "item": [
                {
                    "name": "2.1 Get My Patient Profile",
                    "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{patient_token}}" }], "url": { "raw": "{{base}}/patients/me", "host": ["{{base}}"], "path": ["patients", "me"] } }
                },
                {
                    "name": "2.2 Update My Patient Profile",
                    "request": {
                        "method": "PUT",
                        "header": [{ "key": "Authorization", "value": "Bearer {{patient_token}}" }, { "key": "Content-Type", "value": "application/json" }],
                        "body": { "mode": "raw", "raw": "{\n  \"phone\": \"+919876543211\",\n  \"blood_group\": \"O+\",\n  \"address\": \"123 Test Street, Mumbai\",\n  \"emergency_contact\": \"+919876543200\"\n}" },
                        "url": { "raw": "{{base}}/patients/me", "host": ["{{base}}"], "path": ["patients", "me"] }
                    }
                },
                {
                    "name": "2.3 Submit Onboarding",
                    "event": [{ "listen": "test", "script": { "exec": ["pm.test('Onboarding 201', () => { pm.response.to.have.status(201); });"], "type": "text/javascript" } }],
                    "request": {
                        "method": "POST",
                        "header": [{ "key": "Authorization", "value": "Bearer {{patient_token}}" }, { "key": "Content-Type", "value": "application/json" }],
                        "body": { "mode": "raw", "raw": "{\n  \"has_diabetes\": false,\n  \"has_heart_disease\": false,\n  \"has_lung_disease\": false,\n  \"no_medical_conditions\": true,\n  \"taking_medications\": false,\n  \"has_allergies\": true,\n  \"allergies_list\": \"Peanuts, Shellfish\",\n  \"smoking_status\": \"never\",\n  \"alcohol_use\": \"occasional\",\n  \"had_major_surgeries\": false,\n  \"consent_data_storage\": true,\n  \"consent_ai_assist\": true\n}" },
                        "url": { "raw": "{{base}}/patients/me/onboarding", "host": ["{{base}}"], "path": ["patients", "me", "onboarding"] }
                    }
                },
                {
                    "name": "2.4 Get My Onboarding",
                    "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{patient_token}}" }], "url": { "raw": "{{base}}/patients/me/onboarding", "host": ["{{base}}"], "path": ["patients", "me", "onboarding"] } }
                },
                {
                    "name": "2.5 List All Patients (Doctor)",
                    "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{doctor_token}}" }], "url": { "raw": "{{base}}/patients", "host": ["{{base}}"], "path": ["patients"] } }
                },
                {
                    "name": "2.6 Get Patient By ID (Doctor)",
                    "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{doctor_token}}" }], "url": { "raw": "{{base}}/patients/{{patient_id}}", "host": ["{{base}}"], "path": ["patients", "{{patient_id}}"] } }
                },
                {
                    "name": "2.7 Get Patient Onboarding (Doctor)",
                    "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{doctor_token}}" }], "url": { "raw": "{{base}}/patients/{{patient_id}}/onboarding", "host": ["{{base}}"], "path": ["patients", "{{patient_id}}", "onboarding"] } }
                }
            ]
        },
        {
            "name": "3. Doctors",
            "item": [
                {
                    "name": "3.1 List All Doctors",
                    "request": { "method": "GET", "header": [], "url": { "raw": "{{base}}/doctors", "host": ["{{base}}"], "path": ["doctors"] } }
                },
                {
                    "name": "3.2 Get My Doctor Profile",
                    "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{doctor_token}}" }], "url": { "raw": "{{base}}/doctors/me", "host": ["{{base}}"], "path": ["doctors", "me"] } }
                },
                {
                    "name": "3.3 Update My Doctor Profile",
                    "request": {
                        "method": "PUT",
                        "header": [{ "key": "Authorization", "value": "Bearer {{doctor_token}}" }, { "key": "Content-Type", "value": "application/json" }],
                        "body": { "mode": "raw", "raw": "{\n  \"specialization\": \"Cardiology\",\n  \"hospital_name\": \"MedScribe Central Hospital\"\n}" },
                        "url": { "raw": "{{base}}/doctors/me", "host": ["{{base}}"], "path": ["doctors", "me"] }
                    }
                },
                {
                    "name": "3.4 Get Doctor By ID",
                    "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{doctor_token}}" }], "url": { "raw": "{{base}}/doctors/{{doctor_id}}", "host": ["{{base}}"], "path": ["doctors", "{{doctor_id}}"] } }
                }
            ]
        },
        {
            "name": "4. Appointments",
            "item": [
                {
                    "name": "4.1 Book Appointment (Patient)",
                    "event": [{ "listen": "test", "script": { "exec": ["pm.test('Appointment 201', () => { pm.response.to.have.status(201); }); const json = pm.response.json(); if (json.appointment_id) { pm.collectionVariables.set('appointment_id', json.appointment_id); }"], "type": "text/javascript" } }],
                    "request": {
                        "method": "POST",
                        "header": [{ "key": "Authorization", "value": "Bearer {{patient_token}}" }, { "key": "Content-Type", "value": "application/json" }],
                        "body": { "mode": "raw", "raw": "{\n  \"doctor_id\": \"{{doctor_id}}\",\n  \"appointment_date\": \"2026-03-15T10:00:00Z\",\n  \"appointment_type\": \"telehealth\",\n  \"reason\": \"Recurring headaches and mild fever for 3 days\",\n  \"duration_minutes\": 30\n}" },
                        "url": { "raw": "{{base}}/appointments", "host": ["{{base}}"], "path": ["appointments"] }
                    }
                },
                {
                    "name": "4.2 Schedule Appointment (Doctor)",
                    "event": [{ "listen": "test", "script": { "exec": ["pm.test('Schedule 201', () => { pm.response.to.have.status(201); });"], "type": "text/javascript" } }],
                    "request": {
                        "method": "POST",
                        "header": [{ "key": "Authorization", "value": "Bearer {{doctor_token}}" }, { "key": "Content-Type", "value": "application/json" }],
                        "body": { "mode": "raw", "raw": "{\n  \"patient_id\": \"{{patient_id}}\",\n  \"appointment_date\": \"2026-03-20T14:00:00Z\",\n  \"appointment_type\": \"in_person\",\n  \"reason\": \"Follow-up consultation\",\n  \"duration_minutes\": 20\n}" },
                        "url": { "raw": "{{base}}/appointments/schedule", "host": ["{{base}}"], "path": ["appointments", "schedule"] }
                    }
                },
                {
                    "name": "4.3 List Appointments (Patient)",
                    "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{patient_token}}" }], "url": { "raw": "{{base}}/appointments", "host": ["{{base}}"], "path": ["appointments"] } }
                },
                {
                    "name": "4.4 List Appointments (Doctor)",
                    "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{doctor_token}}" }], "url": { "raw": "{{base}}/appointments", "host": ["{{base}}"], "path": ["appointments"] } }
                },
                {
                    "name": "4.5 Upcoming Appointments (Doctor)",
                    "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{doctor_token}}" }], "url": { "raw": "{{base}}/appointments/upcoming", "host": ["{{base}}"], "path": ["appointments", "upcoming"] } }
                },
                {
                    "name": "4.6 Get Appointment By ID",
                    "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{doctor_token}}" }], "url": { "raw": "{{base}}/appointments/{{appointment_id}}", "host": ["{{base}}"], "path": ["appointments", "{{appointment_id}}"] } }
                },
                {
                    "name": "4.7 Approve Appointment (Doctor)",
                    "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{doctor_token}}" }], "url": { "raw": "{{base}}/appointments/{{appointment_id}}/approve", "host": ["{{base}}"], "path": ["appointments", "{{appointment_id}}", "approve"] } }
                },
                {
                    "name": "4.8 Reject Appointment (Doctor)",
                    "request": {
                        "method": "POST",
                        "header": [{ "key": "Authorization", "value": "Bearer {{doctor_token}}" }, { "key": "Content-Type", "value": "application/json" }],
                        "body": { "mode": "raw", "raw": "{\n  \"reason\": \"Doctor unavailable on requested date\"\n}" },
                        "url": { "raw": "{{base}}/appointments/{{appointment_id}}/reject", "host": ["{{base}}"], "path": ["appointments", "{{appointment_id}}", "reject"] }
                    }
                },
                {
                    "name": "4.9 Update Appointment",
                    "request": {
                        "method": "PUT",
                        "header": [{ "key": "Authorization", "value": "Bearer {{doctor_token}}" }, { "key": "Content-Type", "value": "application/json" }],
                        "body": { "mode": "raw", "raw": "{\n  \"notes\": \"Patient may need follow-up labs\",\n  \"duration_minutes\": 45\n}" },
                        "url": { "raw": "{{base}}/appointments/{{appointment_id}}", "host": ["{{base}}"], "path": ["appointments", "{{appointment_id}}"] }
                    }
                },
                {
                    "name": "4.10 Cancel Appointment (DELETE)",
                    "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{patient_token}}" }], "url": { "raw": "{{base}}/appointments/{{appointment_id}}", "host": ["{{base}}"], "path": ["appointments", "{{appointment_id}}"] } }
                }
            ]
        },
        {
            "name": "5. Consultations",
            "item": [
                {
                    "name": "5.1 Create Consultation (Doctor)",
                    "event": [{ "listen": "test", "script": { "exec": ["pm.test('Consultation 201', () => { pm.response.to.have.status(201); }); const json = pm.response.json(); if (json.consultation_id) { pm.collectionVariables.set('consultation_id', json.consultation_id); }"], "type": "text/javascript" } }],
                    "request": {
                        "method": "POST",
                        "header": [{ "key": "Authorization", "value": "Bearer {{doctor_token}}" }, { "key": "Content-Type", "value": "application/json" }],
                        "body": { "mode": "raw", "raw": "{\n  \"patient_id\": \"{{patient_id}}\",\n  \"appointment_id\": \"{{appointment_id}}\"\n}" },
                        "url": { "raw": "{{base}}/consultations", "host": ["{{base}}"], "path": ["consultations"] }
                    }
                },
                {
                    "name": "5.2 Get Consultation By ID",
                    "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{doctor_token}}" }], "url": { "raw": "{{base}}/consultations/{{consultation_id}}", "host": ["{{base}}"], "path": ["consultations", "{{consultation_id}}"] } }
                },
                {
                    "name": "5.3 Update Consultation (SOAP + ICD + Rx)",
                    "request": {
                        "method": "PUT",
                        "header": [{ "key": "Authorization", "value": "Bearer {{doctor_token}}" }, { "key": "Content-Type", "value": "application/json" }],
                        "body": { "mode": "raw", "raw": "{\n  \"soap_note\": {\n    \"subjective\": \"Patient reports recurring headaches for 3 days with mild fever (100.2F) and occasional nausea. No vomiting. Denies visual changes.\",\n    \"objective\": \"Temp 99.8F, BP 120/80, HR 82, RR 18, SpO2 98%. HEENT: Mild sinus tenderness. Throat mildly erythematous.\",\n    \"assessment\": \"Viral upper respiratory infection with tension-type headache\",\n    \"plan\": \"Rest, hydration, Paracetamol 500mg PRN. Follow-up in 5 days if symptoms persist.\"\n  },\n  \"icd_codes\": [\n    {\"code\": \"J06.9\", \"description\": \"Acute upper respiratory infection, unspecified\"},\n    {\"code\": \"R51\", \"description\": \"Headache\"},\n    {\"code\": \"R50.9\", \"description\": \"Fever, unspecified\"}\n  ],\n  \"prescription\": [\n    {\"drug\": \"Paracetamol\", \"dose\": \"500mg\", \"frequency\": \"Every 6 hours as needed\", \"duration\": \"5 days\"},\n    {\"drug\": \"Ondansetron\", \"dose\": \"4mg\", \"frequency\": \"Twice daily\", \"duration\": \"3 days\"}\n  ],\n  \"patient_summary\": \"You have a viral infection causing your headaches and fever. Take Paracetamol for pain and Ondansetron for nausea. Rest well, drink plenty of fluids. Come back in 5 days if you don't feel better.\",\n  \"status\": \"confirmed\"\n}" },
                        "url": { "raw": "{{base}}/consultations/{{consultation_id}}", "host": ["{{base}}"], "path": ["consultations", "{{consultation_id}}"] }
                    }
                },
                {
                    "name": "5.4 Get Patient Consultation History",
                    "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{doctor_token}}" }], "url": { "raw": "{{base}}/consultations/patient/{{patient_id}}", "host": ["{{base}}"], "path": ["consultations", "patient", "{{patient_id}}"] } }
                },
                {
                    "name": "5.5 Process Audio (Transcribe + Extract + EMR)",
                    "request": {
                        "method": "POST",
                        "header": [{ "key": "Authorization", "value": "Bearer {{doctor_token}}" }],
                        "body": { "mode": "formdata", "formdata": [{ "key": "file", "type": "file", "src": "", "description": "Audio file (WAV/MP3)" }] },
                        "url": { "raw": "{{base}}/consultations/{{consultation_id}}/process-audio", "host": ["{{base}}"], "path": ["consultations", "{{consultation_id}}", "process-audio"] }
                    }
                }
            ]
        },
        {
            "name": "6. Documents",
            "item": [
                {
                    "name": "6.1 Upload Document",
                    "event": [{ "listen": "test", "script": { "exec": ["const json = pm.response.json(); if (json.document_id) { pm.collectionVariables.set('document_id', json.document_id); }"], "type": "text/javascript" } }],
                    "request": {
                        "method": "POST",
                        "header": [{ "key": "Authorization", "value": "Bearer {{patient_token}}" }],
                        "body": { "mode": "formdata", "formdata": [{ "key": "file", "type": "file", "src": "", "description": "PDF or image file" }, { "key": "patient_id", "value": "{{patient_id}}", "type": "text" }, { "key": "document_type", "value": "lab_report", "type": "text" }, { "key": "notes", "value": "Lab report upload via Postman", "type": "text" }] },
                        "url": { "raw": "{{base}}/documents/upload", "host": ["{{base}}"], "path": ["documents", "upload"] }
                    }
                },
                {
                    "name": "6.2 Get Document By ID",
                    "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{patient_token}}" }], "url": { "raw": "{{base}}/documents/{{document_id}}", "host": ["{{base}}"], "path": ["documents", "{{document_id}}"] } }
                },
                {
                    "name": "6.3 Check Analysis Status",
                    "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{patient_token}}" }], "url": { "raw": "{{base}}/documents/{{document_id}}/analysis-status", "host": ["{{base}}"], "path": ["documents", "{{document_id}}", "analysis-status"] } }
                },
                {
                    "name": "6.4 List Patient Documents",
                    "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{patient_token}}" }], "url": { "raw": "{{base}}/documents/patient/{{patient_id}}", "host": ["{{base}}"], "path": ["documents", "patient", "{{patient_id}}"] } }
                },
                {
                    "name": "6.5 Patient View (AI Summary)",
                    "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{patient_token}}" }], "url": { "raw": "{{base}}/documents/{{document_id}}/patient-view", "host": ["{{base}}"], "path": ["documents", "{{document_id}}", "patient-view"] } }
                },
                {
                    "name": "6.6 Clinician View (AI Summary)",
                    "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{doctor_token}}" }], "url": { "raw": "{{base}}/documents/{{document_id}}/clinician-view", "host": ["{{base}}"], "path": ["documents", "{{document_id}}", "clinician-view"] } }
                }
            ]
        },
        {
            "name": "7. Meetings (LiveKit)",
            "item": [
                {
                    "name": "7.1 Create Meeting Room",
                    "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{doctor_token}}" }], "url": { "raw": "{{base}}/meetings/{{appointment_id}}/create-room", "host": ["{{base}}"], "path": ["meetings", "{{appointment_id}}", "create-room"] } }
                },
                {
                    "name": "7.2 Get Join Token (Doctor)",
                    "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{doctor_token}}" }], "url": { "raw": "{{base}}/meetings/{{appointment_id}}/join-token", "host": ["{{base}}"], "path": ["meetings", "{{appointment_id}}", "join-token"] } }
                },
                {
                    "name": "7.3 Get Join Token (Patient)",
